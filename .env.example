# ==============================================================================
# AI EXECUTIVE BOARDROOM CONFIGURATION
# ==============================================================================

# Google Gemini API Key (Server-side only; NEVER commit your real key to GitHub!)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Gemini Model:
# - gemini-3.8-flash (Latest official flash model)
# - gemini-2.5-flash
GEMINI_MODEL=gemini-3.8-flash

# Tavily Search API Key for real-world strategy & live web market intelligence
# Get an API key at: https://tavily.com
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Database connection (SQLite default for local development)
DATABASE_URL=sqlite:///./boardroom.db

# Frontend and CORS URLs
FRONTEND_URL=http://localhost:3000

# File Upload Storage
UPLOAD_DIR=./uploads

# Allow transparent offline simulation mode when no API key is provided
ALLOW_SIMULATION_MODE=true
