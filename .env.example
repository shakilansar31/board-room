# ==============================================================================
# AI EXECUTIVE BOARDROOM CONFIGURATION
# ==============================================================================

# Google Gemini API Key (Server-side only; NEVER expose to client or git)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Gemini Model (verified with official google-genai SDK):
# - gemini-2.5-flash (Fast, cost-effective, supports structured outputs)
# - gemini-1.5-flash / gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Database connection (SQLite default for project mode)
DATABASE_URL=sqlite:///./boardroom.db

# Frontend and CORS URLs
FRONTEND_URL=http://localhost:3000

# File Upload Storage
UPLOAD_DIR=./uploads

# Allow transparent offline simulation mode when no API key is provided
ALLOW_SIMULATION_MODE=true
